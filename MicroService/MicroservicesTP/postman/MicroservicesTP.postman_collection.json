    {
      "name": "03 — Communication RabbitMQ (mutation contrôlée)",
      "description": "Reproduit le test du PDF p. 51-52 : POST d'un produit, puis vérification de la consommation par la file event-listener. Le POST ajoute réellement une ligne dans Products.db et une projection dans Orders.db. Vérifier ensuite la projection avec la requête SQLite en lecture seule du README.",
      "item": [
        {
          "name": "ProductsAPI — POST produit de test",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const product = pm.response.json();",
                  "pm.test('Produit créé avec un identifiant', () => pm.expect(product.productId).to.be.above(0));",
                  "pm.collectionVariables.set('createdProductId', product.productId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman-{{$timestamp}}\",\n  \"stockQte\": 1,\n  \"price\": 9.99\n}"
            },
            "url": "{{productsUrl}}/api/Products"
          }
        },
        {
          "name": "ProductsAPI — relire le produit créé",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Identifiant du produit créé', () => pm.expect(pm.response.json().productId).to.eql(Number(pm.collectionVariables.get('createdProductId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productsUrl}}/api/Products/{{createdProductId}}"
          }
        },
        {
          "name": "RabbitMQ — vérifier la consommation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const queue = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('File event-listener', () => pm.expect(queue.name).to.eql('event-listener'));",
                  "pm.test('Consumer actif', () => pm.expect(queue.consumers).to.be.at.least(1));",
                  "pm.test('Message consommé (aucun en attente)', () => pm.expect(queue.messages).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitmqUrl}}/api/queues/%2F/event-listener",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitmqUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitmqPassword}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
