    {
      "name": "01 — Gateway Ocelot (lecture seule)",
      "description": "Parcours du PDF p. 27-29 : les deux microservices sont appelés via la Gateway, sans contournement.",
      "item": [
        {
          "name": "Gateway — liste des produits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tableau de produits', () => pm.expect(products).to.be.an('array'));",
                  "if (products.length > 0) {",
                  "  pm.collectionVariables.set('productId', products[0].productId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/apigateway/Products"
          }
        },
        {
          "name": "Gateway — produit par identifiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Identifiant attendu', () => pm.expect(pm.response.json().productId).to.eql(Number(pm.collectionVariables.get('productId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/apigateway/Products/{{productId}}"
          }
        },
        {
          "name": "Gateway — liste des commandes",
          "event": [
            {
              "listen": "test",
              "script": {
