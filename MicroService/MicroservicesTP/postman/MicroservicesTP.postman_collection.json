{
  "info": {
    "_postman_id": "a133d61a-816a-4b1c-af2d-3707a6aa955f",
    "name": "MicroservicesTP — Atelier 8",
    "description": "Collection Postman du TP « Introduction aux Microservices avec ASP.NET Core » (PDF p. 27-29 et p. 51-52).\n\nDossiers 00 à 02 : lecture seule.\nDossier 03 : mutation contrôlée — le POST ajoute un produit dans Products.db et déclenche ProductCreated ; la projection doit apparaître dans Orders.db.\n\nNe pas exécuter le dossier 03 sur une base dont les données ne doivent pas être modifiées. Le dossier ne contient volontairement aucun DELETE : supprimer un produit dans ProductsAPI ne supprime pas sa projection dans OrdersAPI (pas d'événement ProductDeleted dans le PDF).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 — Santé (lecture seule)",
      "description": "Vérifie que les trois services et le broker répondent. Aucune écriture.",
      "item": [
        {
          "name": "Gateway — GET /apigateway/Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Corps JSON', () => pm.response.to.be.json);",
                  "pm.test('Tableau de produits', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/apigateway/Products"
          }
        },
        {
          "name": "ProductsAPI — Swagger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productsUrl}}/swagger/index.html"
          }
        },
        {
          "name": "OrdersAPI — Swagger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ordersUrl}}/swagger/index.html"
          }
        },
        {
          "name": "RabbitMQ — Overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Broker RabbitMQ', () => pm.expect(pm.response.json().product_name).to.eql('RabbitMQ'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitmqUrl}}/api/overview",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitmqUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitmqPassword}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "RabbitMQ — file event-listener",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const queue = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('File event-listener', () => pm.expect(queue.name).to.eql('event-listener'));",
                  "pm.test('Au moins 1 consumer', () => pm.expect(queue.consumers).to.be.at.least(1));",
                  "pm.test('Aucun message en attente', () => pm.expect(queue.messages).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitmqUrl}}/api/queues/%2F/event-listener",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitmqUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitmqPassword}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
