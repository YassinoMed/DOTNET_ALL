{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=SecureAPI_JWT.db"
  },
  "JwtSettings": {
    // La clé de signature n'est volontairement pas stockée dans le dépôt.
    // Développement : dotnet user-secrets set "JwtSettings:Key" "<secret de 32+ octets>"
    // Production   : variable d'environnement JwtSettings__Key (ou coffre-fort de secrets).
    "Issuer": "SecureAPI_JWT",
    "Audience": "SecureAPI_JWT_Client",
    "DurationInDays": 1,
    "RefreshTokenDurationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
