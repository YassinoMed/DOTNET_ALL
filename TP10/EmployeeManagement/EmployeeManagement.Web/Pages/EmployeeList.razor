@page "/EmployeeList"
@inherits EmployeeListBase

<PageTitle>Employee List</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Employee List</h1>
        <p class="text-muted mb-0">Manage employees and their department assignments.</p>
    </div>
    <a href="editemployee" class="btn btn-primary">
        <span class="oi oi-plus me-1" aria-hidden="true"></span> Add Employee
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @SuccessMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="ClearMessages"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadEmployeesAsync">Retry</button>
    </div>
}

@if (IsLoading)
{
    <div class="d-flex align-items-center gap-2 py-5 justify-content-center" role="status" aria-live="polite">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <span>Loading employees...</span>
    </div>
}
else if (Employees.Count == 0 && string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="card text-center py-5 shadow-sm">
        <div class="card-body">
            <h2 class="h5">No employees found</h2>
            <p class="text-muted">The employee directory is currently empty.</p>
            <a href="editemployee" class="btn btn-primary">Add First Employee</a>
        </div>
    </div>
}
else if (Employees.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var employee in Employees)
        {
            <div class="col">
                <div class="card h-100 shadow-sm employee-card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-3 min-w-0">
                            <img class="employee-avatar-circle flex-shrink-0"
                                 src="@EmployeeService.ResolvePhotoUrl(employee.PhotoPath)"
                                 onerror="this.onerror=null;this.src='images/avatar-default.svg';"
                                 alt="@($"{employee.FirstName} {employee.LastName}")" />
                            <h2 class="h5 mb-0 text-truncate">@employee.FirstName @employee.LastName</h2>
                        </div>
                        <span class="badge bg-info text-dark flex-shrink-0">
                            @(employee.Department?.DepartmentName ?? $"Dept #{employee.DepartmentId}")
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-1 text-truncate"><strong>Email:</strong> @employee.Email</p>
                        <p class="mb-1"><strong>Gender:</strong> @employee.Gender</p>
                        <p class="mb-0"><strong>Birth Date:</strong> @employee.DateOfBirth.ToString("yyyy-MM-dd")</p>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-center gap-2 flex-wrap">
                        <a href="@($"EmployeeDetails/{employee.EmployeeId}")" class="btn btn-primary btn-sm">View</a>
                        <a href="@($"editemployee/{employee.EmployeeId}")" class="btn btn-outline-primary btn-sm">Edit</a>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                @onclick="() => RequestDelete(employee)">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (EmployeePendingDelete != null)
{
    <div class="modal-backdrop-custom" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
        <div class="modal-dialog-custom card shadow-lg">
            <div class="card-header bg-danger text-white">
                <h2 id="deleteModalTitle" class="h5 mb-0">Confirm Deletion</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Are you sure you want to delete
                    <strong>@EmployeePendingDelete.FirstName @EmployeePendingDelete.LastName</strong>?
                </p>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@IsDeleting"
                        @onclick="CancelDelete">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-danger btn-sm"
                        disabled="@IsDeleting"
                        @onclick="ConfirmDeleteAsync">
                    @(IsDeleting ? "Deleting..." : "Confirm Delete")
                </button>
            </div>
        </div>
    </div>
}
